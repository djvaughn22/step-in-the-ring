# StepInTheRing — environment (server-side unless prefixed NEXT_PUBLIC_)
# PLACEHOLDERS ONLY — never commit real values.

# ── Owner access (existing shared owner gate) ────────────────────────────────
STORY_OWNER_PASSWORD=
# Optional: rotate sessions independently of the password.
STORY_SESSION_SECRET=

# ── Membership (Step In The Ring Membership, $7.77/month) ────────────────────
# Neon/other Postgres. With this unset, every membership feature fails closed
# with an honest "private beta being prepared" message.
DATABASE_URL=
# Public origin used for Stripe return URLs — the ONLY allowed redirect base.
MEMBER_APP_URL=https://stepinthering.com
# Stripe (use sk_test_/whsec_/price_ test values until live billing is
# owner-approved; the code labels live mode from the key prefix).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# HMAC secret for hashing tester codes (>=16 chars, random).
TESTER_CODE_SECRET=
# Optional email delivery for verification/recovery (disabled until set).
RESEND_API_KEY=
MEMBER_EMAIL_FROM=

# Etsy Open API v3 (Design Shop Engine publishing — not yet connected).
# SERVER ONLY. Never expose these to the client or commit real values.
ETSY_SHOP_ID=
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ETSY_REDIRECT_URI=
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=
